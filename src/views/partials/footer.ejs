<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Column 1: Brand & Social -->
      <div class="footer-brand">
        <a href="/" class="navbar-brand" style="display:inline-flex;align-items:center;gap:8px;margin-bottom:8px;">
          <div class="logo-icon">K</div>
          <div class="brand-text">
            <span class="brand-name"><%= settings.site_name || 'الكيف' %></span>
            <span class="brand-sub"><%= settings.site_name_en || 'EL-KAIF CARS' %></span>
          </div>
        </a>
        <p><%= settings.footer_description || 'وجهتك الأولى لأفخم السيارات المستعملة والجديدة. نقدم لك أفضل العروض وأجود السيارات بأسعار تنافسية وخدمة متميزة.' %></p>
        <div class="footer-social">
          <a href="<%= settings.facebook || '#' %>" target="_blank" rel="noopener" aria-label="فيسبوك"><i class="fab fa-facebook-f"></i></a>
          <a href="<%= settings.twitter || '#' %>" target="_blank" rel="noopener" aria-label="تويتر"><i class="fab fa-twitter"></i></a>
          <a href="<%= settings.instagram || '#' %>" target="_blank" rel="noopener" aria-label="انستقرام"><i class="fab fa-instagram"></i></a>
          <a href="<%= settings.youtube || '#' %>" target="_blank" rel="noopener" aria-label="يوتيوب"><i class="fab fa-youtube"></i></a>
          <a href="<%= settings.tiktok || '#' %>" target="_blank" rel="noopener" aria-label="تيك توك"><i class="fab fa-tiktok"></i></a>
          <a href="<%= settings.snapchat || '#' %>" target="_blank" rel="noopener" aria-label="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
          <a href="<%= settings.linkedin || '#' %>" target="_blank" rel="noopener" aria-label="لينكد إن"><i class="fab fa-linkedin-in"></i></a>
          <a href="<%= settings.whatsapp ? 'https://wa.me/' + settings.whatsapp : '#' %>" target="_blank" rel="noopener" aria-label="واتساب"><i class="fab fa-whatsapp"></i></a>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="footer-col">
        <h4>روابط سريعة</h4>
        <ul>
          <li><a href="/">الرئيسية</a></li>
          <li><a href="/cars">السيارات</a></li>
          <li><a href="/brands">العلامات التجارية</a></li>
          <li><a href="/about">عن الموقع</a></li>
          <li><a href="/contact">تواصل معنا</a></li>
        </ul>
      </div>

      <!-- Column 3: Services -->
      <div class="footer-col">
        <h4>خدماتنا</h4>
        <ul>
          <li><a href="/cars">شراء سيارة</a></li>
          <li><a href="/contact">تمويل السيارات</a></li>
          <li><a href="/contact">تأمين السيارات</a></li>
          <li><a href="/contact">صيانة السيارات</a></li>
          <li><a href="/contact">فحص السيارات</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact Info -->
      <div class="footer-col">
        <h4>تواصل معنا</h4>
        <div class="footer-contact-item">
          <i class="fas fa-phone-alt"></i>
          <div class="info">
            <span>اتصل بنا</span>
            <a href="tel:<%= settings.phone || '' %>" dir="ltr"><%= settings.phone || '---' %></a>
          </div>
        </div>
        <div class="footer-contact-item">
          <i class="fas fa-envelope"></i>
          <div class="info">
            <span>البريد الإلكتروني</span>
            <a href="mailto:<%= settings.email || '' %>"><%= settings.email || '---' %></a>
          </div>
        </div>
        <div class="footer-contact-item">
          <i class="fas fa-map-marker-alt"></i>
          <div class="info">
            <span>العنوان</span>
            <p><%= settings.address || '---' %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <p>&copy; <%= new Date().getFullYear() %> <a href="/"><%= settings.site_name || 'الكيف للسيارات' %></a>. جميع الحقوق محفوظة.</p>
      <p>تصميم وتطوير بواسطة <a href="<%= settings.developer_url || '#' %>" target="_blank" rel="noopener"><%= settings.developer_name || 'فريق التطوير' %></a></p>
    </div>
  </div>
</footer>
