<div class="share-modal-overlay" id="shareModal">
  <div class="share-modal" style="position:relative;">
    <button class="share-modal-close" id="shareModalClose" aria-label="إغلاق">
      <i class="fas fa-times"></i>
    </button>
    <h3>مشاركة</h3>
    <div class="share-options">
      <a href="#" class="share-option twitter" id="shareTwitter" target="_blank" rel="noopener" aria-label="مشاركة على تويتر">
        <i class="fab fa-twitter"></i>
      </a>
      <a href="#" class="share-option facebook" id="shareFacebook" target="_blank" rel="noopener" aria-label="مشاركة على فيسبوك">
        <i class="fab fa-facebook-f"></i>
      </a>
      <a href="#" class="share-option whatsapp" id="shareWhatsapp" target="_blank" rel="noopener" aria-label="مشاركة على واتساب">
        <i class="fab fa-whatsapp"></i>
      </a>
    </div>
    <div class="share-url-box">
      <input type="text" id="shareUrlInput" readonly>
      <button id="shareUrlCopy">نسخ</button>
    </div>
  </div>
</div>
