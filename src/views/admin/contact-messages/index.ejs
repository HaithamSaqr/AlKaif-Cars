<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <%- include('../partials/admin-head') %>
</head>
<body>
  <%- include('../partials/admin-sidebar') %>

  <div class="admin-main">
    <%- include('../partials/flash-messages') %>

    <h1>الرسائل الواردة</h1>

    <div class="table-wrapper">
      <div class="table-search">
        <input type="text" class="form-control table-search-input" data-table="messagesTable" placeholder="بحث في الرسائل...">
      </div>
      <table class="admin-table" id="messagesTable">
        <thead>
          <tr>
            <th>الاسم</th>
            <th>الموضوع</th>
            <th>التاريخ</th>
            <th>الحالة</th>
            <th>الإجراءات</th>
          </tr>
        </thead>
        <tbody>
          <% if (messages && messages.length > 0) { %>
            <% messages.forEach(function(m) { %>
            <tr style="<%= !m.is_read ? 'font-weight:600;' : '' %>">
              <td><%= m.name %></td>
              <td><%= m.subject || '---' %></td>
              <td><%= m.created_at ? new Date(m.created_at).toLocaleDateString('ar-EG') : '---' %></td>
              <td>
                <span class="badge badge-<%= m.is_read ? 'read' : 'unread' %>">
                  <%= m.is_read ? 'مقروء' : 'جديد' %>
                </span>
              </td>
              <td>
                <div class="table-actions">
                  <a href="/admin/contact-messages/<%= m.id %>" class="btn btn-sm btn-outline"><i class="fas fa-eye"></i></a>
                  <form action="/admin/contact-messages/<%= m.id %>/delete" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('هل أنت متأكد من الحذف؟')"><i class="fas fa-trash"></i></button>
                  </form>
                </div>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="5" style="text-align:center;color:var(--gray);padding:32px;">لا توجد رسائل</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (pages > 1) { %>
    <div class="pagination">
      <% if (currentPage > 1) { %>
        <a href="/admin/contact-messages?page=<%= currentPage - 1 %>"><i class="fas fa-chevron-right"></i></a>
      <% } %>
      <% for (var i = 1; i <= pages; i++) { %>
        <a href="/admin/contact-messages?page=<%= i %>" class="<%= i === currentPage ? 'active' : '' %>"><%= i %></a>
      <% } %>
      <% if (currentPage < pages) { %>
        <a href="/admin/contact-messages?page=<%= currentPage + 1 %>"><i class="fas fa-chevron-left"></i></a>
      <% } %>
    </div>
    <% } %>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
