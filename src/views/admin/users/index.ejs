<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <%- include('../partials/admin-head') %>
</head>
<body>
  <%- include('../partials/admin-sidebar') %>

  <div class="admin-main">
    <%- include('../partials/flash-messages') %>

    <div class="page-header">
      <h1>إدارة المستخدمين</h1>
      <a href="/admin/users/create" class="btn btn-primary"><i class="fas fa-plus"></i> إضافة مستخدم</a>
    </div>

    <div class="table-wrapper">
      <div class="table-search">
        <input type="text" class="form-control table-search-input" data-table="usersTable" placeholder="بحث في المستخدمين...">
      </div>
      <table class="admin-table" id="usersTable">
        <thead>
          <tr>
            <th>اسم المستخدم</th>
            <th>الاسم الكامل</th>
            <th>البريد الإلكتروني</th>
            <th>الصلاحية</th>
            <th>الحالة</th>
            <th>الإجراءات</th>
          </tr>
        </thead>
        <tbody>
          <% if (users && users.length > 0) { %>
            <% users.forEach(function(u) { %>
            <tr>
              <td><%= u.username %></td>
              <td><%= u.full_name || '---' %></td>
              <td><%= u.email || '---' %></td>
              <td>
                <span class="badge badge-<%= u.role %>">
                  <%= u.role === 'admin' ? 'مدير' : 'محرر' %>
                </span>
              </td>
              <td>
                <span class="badge badge-<%= u.is_active ? 'green' : 'gray' %>">
                  <%= u.is_active ? 'مفعل' : 'معطل' %>
                </span>
              </td>
              <td>
                <div class="table-actions">
                  <a href="/admin/users/<%= u.id %>/edit" class="btn btn-sm btn-outline"><i class="fas fa-edit"></i></a>
                  <% if (u.id !== session.userId) { %>
                  <form action="/admin/users/<%= u.id %>/delete" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('هل أنت متأكد من حذف هذا المستخدم؟')"><i class="fas fa-trash"></i></button>
                  </form>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="6" style="text-align:center;color:var(--gray);padding:32px;">لا يوجد مستخدمين</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
