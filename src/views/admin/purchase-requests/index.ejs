<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <%- include('../partials/admin-head') %>
  <style>
    .pr-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; }
    .pr-header h1 { margin: 0; font-size: 28px; }
    .pr-count { font-size: 14px; color: var(--gray, #999); margin-top: 4px; }

    .status-tabs { display: flex; gap: 8px; margin-bottom: 28px; flex-wrap: wrap; }
    .status-tab {
      padding: 10px 22px;
      border-radius: 30px;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.3s;
      border: 1px solid #383838;
      color: #B0B0B0;
      background: #1A1A1A;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .status-tab:hover { border-color: #E31E24; color: #fff; }
    .status-tab.active { background: #E31E24; border-color: #E31E24; color: #fff; }
    .status-tab .tab-count {
      background: rgba(255,255,255,0.2);
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 12px;
      min-width: 20px;
      text-align: center;
    }
    .status-tab.active .tab-count { background: rgba(255,255,255,0.3); }

    .pr-table { width: 100%; border-collapse: collapse; }
    .pr-table thead th {
      padding: 14px 16px;
      font-size: 13px;
      font-weight: 700;
      color: #B0B0B0;
      text-align: right;
      border-bottom: 2px solid #383838;
      white-space: nowrap;
    }
    .pr-table tbody tr {
      border-bottom: 1px solid #2A2A2A;
      transition: background 0.2s;
      cursor: pointer;
    }
    .pr-table tbody tr:hover { background: rgba(227,30,36,0.05); }
    .pr-table tbody td {
      padding: 16px;
      font-size: 14px;
      color: #ddd;
      vertical-align: middle;
    }

    .pr-name { font-weight: 700; color: #fff; display: block; margin-bottom: 2px; }
    .pr-phone { font-size: 12px; color: #888; direction: ltr; display: inline-block; }

    .pr-car { display: flex; flex-direction: column; gap: 2px; }
    .pr-car-name { font-weight: 600; color: #E31E24; font-size: 13px; }
    .pr-car-price { font-size: 12px; color: #888; }

    .badge-status {
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      display: inline-block;
      white-space: nowrap;
    }
    .badge-new { background: rgba(227,30,36,0.15); color: #E31E24; border: 1px solid rgba(227,30,36,0.3); }
    .badge-in_progress { background: rgba(255,193,7,0.15); color: #FFC107; border: 1px solid rgba(255,193,7,0.3); }
    .badge-completed { background: rgba(76,175,80,0.15); color: #4CAF50; border: 1px solid rgba(76,175,80,0.3); }
    .badge-cancelled { background: rgba(158,158,158,0.15); color: #9E9E9E; border: 1px solid rgba(158,158,158,0.3); }

    .badge-type {
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 700;
    }
    .badge-individual { background: rgba(33,150,243,0.15); color: #2196F3; }
    .badge-corporate { background: rgba(156,39,176,0.15); color: #CE93D8; }

    .pr-date { font-size: 13px; color: #888; white-space: nowrap; }
    .pr-time { font-size: 11px; color: #666; display: block; }

    .view-btn {
      padding: 8px 18px;
      background: transparent;
      border: 1px solid #E31E24;
      color: #E31E24;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s;
      white-space: nowrap;
    }
    .view-btn:hover { background: #E31E24; color: #fff; }

    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #666;
    }
    .empty-state i { font-size: 48px; color: #383838; margin-bottom: 16px; display: block; }
    .empty-state h3 { color: #888; font-size: 18px; margin-bottom: 8px; }
    .empty-state p { font-size: 14px; }

    .pr-row-new { border-right: 3px solid #E31E24; }

    @media (max-width: 768px) {
      .pr-table thead { display: none; }
      .pr-table tbody tr { display: block; padding: 16px; margin-bottom: 12px; background: #1A1A1A; border-radius: 12px; border: 1px solid #383838; }
      .pr-table tbody td { display: flex; justify-content: space-between; padding: 8px 0; border: none; }
      .pr-table tbody td::before { content: attr(data-label); font-weight: 700; color: #888; font-size: 12px; }
    }
  </style>
</head>
<body>
  <%- include('../partials/admin-sidebar') %>

  <div class="admin-main">
    <%- include('../partials/flash-messages') %>

    <div class="pr-header">
      <div>
        <h1><i class="fas fa-shopping-cart" style="color:#E31E24;margin-left:10px;"></i>طلبات الشراء</h1>
        <div class="pr-count">إجمالي <%= total %> طلب</div>
      </div>
    </div>

    <!-- Status Filter Tabs -->
    <div class="status-tabs">
      <a href="/admin/purchase-requests" class="status-tab <%= !currentStatus ? 'active' : '' %>">
        <i class="fas fa-list"></i> الكل
        <span class="tab-count"><%= total %></span>
      </a>
      <a href="/admin/purchase-requests?status=new" class="status-tab <%= currentStatus === 'new' ? 'active' : '' %>">
        <i class="fas fa-bell"></i> جديد
      </a>
      <a href="/admin/purchase-requests?status=in_progress" class="status-tab <%= currentStatus === 'in_progress' ? 'active' : '' %>">
        <i class="fas fa-spinner"></i> قيد المعالجة
      </a>
      <a href="/admin/purchase-requests?status=completed" class="status-tab <%= currentStatus === 'completed' ? 'active' : '' %>">
        <i class="fas fa-check-circle"></i> مكتمل
      </a>
      <a href="/admin/purchase-requests?status=cancelled" class="status-tab <%= currentStatus === 'cancelled' ? 'active' : '' %>">
        <i class="fas fa-times-circle"></i> ملغي
      </a>
    </div>

    <% if (requests && requests.length > 0) { %>
    <div class="table-wrapper" style="background:#1A1A1A;border:1px solid #383838;border-radius:16px;overflow:hidden;">
      <table class="pr-table">
        <thead>
          <tr>
            <th>#</th>
            <th>مقدم الطلب</th>
            <th>السيارة</th>
            <th>النوع</th>
            <th>طريقة الدفع</th>
            <th>الحالة</th>
            <th>التاريخ</th>
            <th>إجراء</th>
          </tr>
        </thead>
        <tbody>
          <% requests.forEach(function(r) { %>
          <tr class="<%= r.status === 'new' ? 'pr-row-new' : '' %>" onclick="window.location='/admin/purchase-requests/<%= r.id %>'">
            <td data-label="#">
              <strong style="color:#888;">#<%= r.id %></strong>
            </td>
            <td data-label="مقدم الطلب">
              <span class="pr-name"><%= r.full_name || r.company_name || '---' %></span>
              <span class="pr-phone"><%= r.phone || '' %></span>
            </td>
            <td data-label="السيارة">
              <div class="pr-car">
                <span class="pr-car-name"><%= r.car_name_en || r.car_name || '---' %></span>
                <% if (r.price) { %>
                <span class="pr-car-price"><%= Number(r.price).toLocaleString() %> ر.س</span>
                <% } %>
              </div>
            </td>
            <td data-label="النوع">
              <span class="badge-type badge-<%= r.request_type %>">
                <i class="fas fa-<%= r.request_type === 'individual' ? 'user' : 'building' %>"></i>
                <%= r.request_type === 'individual' ? 'فرد' : 'شركة' %>
              </span>
            </td>
            <td data-label="الدفع">
              <% if (r.payment_method) { %>
                <span style="font-size:13px;"><i class="fas fa-<%= r.payment_method === 'تمويل' ? 'university' : 'money-bill' %>" style="color:#E31E24;margin-left:4px;"></i><%= r.payment_method %></span>
              <% } else { %>
                <span style="color:#666;">---</span>
              <% } %>
            </td>
            <td data-label="الحالة">
              <span class="badge-status badge-<%= r.status %>">
                <%= r.status === 'new' ? 'جديد' : r.status === 'in_progress' ? 'قيد المعالجة' : r.status === 'completed' ? 'مكتمل' : 'ملغي' %>
              </span>
            </td>
            <td data-label="التاريخ">
              <% if (r.created_at) { var d = new Date(r.created_at); %>
              <span class="pr-date"><%= d.toLocaleDateString('ar-EG') %></span>
              <span class="pr-time"><%= d.toLocaleTimeString('ar-EG', {hour:'2-digit', minute:'2-digit'}) %></span>
              <% } else { %>
              <span class="pr-date">---</span>
              <% } %>
            </td>
            <td data-label="إجراء" onclick="event.stopPropagation()">
              <a href="/admin/purchase-requests/<%= r.id %>" class="view-btn">
                <i class="fas fa-eye"></i> عرض
              </a>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (pages > 1) { %>
    <div class="pagination" style="margin-top:24px;display:flex;justify-content:center;gap:8px;">
      <% if (currentPage > 1) { %>
        <a href="/admin/purchase-requests?page=<%= currentPage - 1 %><%= currentStatus ? '&status=' + currentStatus : '' %>" style="padding:8px 14px;background:#1A1A1A;border:1px solid #383838;border-radius:8px;color:#B0B0B0;text-decoration:none;"><i class="fas fa-chevron-right"></i></a>
      <% } %>
      <% for (var i = 1; i <= pages; i++) { %>
        <a href="/admin/purchase-requests?page=<%= i %><%= currentStatus ? '&status=' + currentStatus : '' %>" style="padding:8px 14px;background:<%= i === currentPage ? '#E31E24' : '#1A1A1A' %>;border:1px solid <%= i === currentPage ? '#E31E24' : '#383838' %>;border-radius:8px;color:#fff;text-decoration:none;font-weight:700;"><%= i %></a>
      <% } %>
      <% if (currentPage < pages) { %>
        <a href="/admin/purchase-requests?page=<%= currentPage + 1 %><%= currentStatus ? '&status=' + currentStatus : '' %>" style="padding:8px 14px;background:#1A1A1A;border:1px solid #383838;border-radius:8px;color:#B0B0B0;text-decoration:none;"><i class="fas fa-chevron-left"></i></a>
      <% } %>
    </div>
    <% } %>

    <% } else { %>
    <div class="empty-state">
      <i class="fas fa-inbox"></i>
      <h3>لا توجد طلبات <%= currentStatus === 'new' ? 'جديدة' : currentStatus === 'in_progress' ? 'قيد المعالجة' : currentStatus === 'completed' ? 'مكتملة' : currentStatus === 'cancelled' ? 'ملغية' : '' %></h3>
      <p>ستظهر الطلبات هنا عندما يقوم العملاء بإرسال طلبات شراء من الموقع</p>
    </div>
    <% } %>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
