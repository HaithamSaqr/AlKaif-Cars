<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <%- include('partials/admin-head') %>
</head>
<body>
  <%- include('partials/admin-sidebar') %>

  <div class="admin-main">
    <%- include('partials/flash-messages') %>

    <h1>لوحة التحكم</h1>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-car"></i></div>
        <div class="stat-info">
          <h3><%= carCount %></h3>
          <p>السيارات</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-tags"></i></div>
        <div class="stat-info">
          <h3><%= brandCount %></h3>
          <p>العلامات التجارية</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-file-alt"></i></div>
        <div class="stat-info">
          <h3><%= newPurchaseRequests %></h3>
          <p>طلبات جديدة</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-envelope"></i></div>
        <div class="stat-info">
          <h3><%= unreadMessages %></h3>
          <p>رسائل غير مقروءة</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-users"></i></div>
        <div class="stat-info">
          <h3><%= userCount %></h3>
          <p>المستخدمين</p>
        </div>
      </div>
    </div>

    <!-- Recent Purchase Requests -->
    <h2 style="font-size:18px;margin-bottom:16px;">آخر طلبات الشراء</h2>
    <div class="table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th>#</th>
            <th>الاسم</th>
            <th>السيارة</th>
            <th>الهاتف</th>
            <th>الحالة</th>
            <th>التاريخ</th>
            <th>عرض</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentRequests && recentRequests.length > 0) { %>
            <% recentRequests.forEach(function(r) { %>
            <tr>
              <td><%= r.id %></td>
              <td><%= r.full_name || r.company_name || '---' %></td>
              <td><%= r.car_name_en || r.car_name || '---' %></td>
              <td dir="ltr"><%= r.phone || '---' %></td>
              <td>
                <span class="badge badge-<%= r.status %>">
                  <%= r.status === 'new' ? 'جديد' : r.status === 'in_progress' ? 'قيد المعالجة' : r.status === 'completed' ? 'مكتمل' : 'ملغي' %>
                </span>
              </td>
              <td><%= r.created_at ? new Date(r.created_at).toLocaleDateString('ar-EG') : '---' %></td>
              <td>
                <a href="/admin/purchase-requests/<%= r.id %>" class="btn btn-sm btn-outline"><i class="fas fa-eye"></i></a>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="7" style="text-align:center;color:var(--gray);">لا توجد طلبات</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Recent Contact Messages -->
    <h2 style="font-size:18px;margin-bottom:16px;">آخر الرسائل</h2>
    <div class="table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th>الاسم</th>
            <th>الموضوع</th>
            <th>الحالة</th>
            <th>التاريخ</th>
            <th>عرض</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentMessages && recentMessages.length > 0) { %>
            <% recentMessages.forEach(function(m) { %>
            <tr>
              <td><%= m.name %></td>
              <td><%= m.subject || '---' %></td>
              <td>
                <span class="badge badge-<%= m.is_read ? 'read' : 'unread' %>">
                  <%= m.is_read ? 'مقروء' : 'جديد' %>
                </span>
              </td>
              <td><%= m.created_at ? new Date(m.created_at).toLocaleDateString('ar-EG') : '---' %></td>
              <td>
                <a href="/admin/contact-messages/<%= m.id %>" class="btn btn-sm btn-outline"><i class="fas fa-eye"></i></a>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="5" style="text-align:center;color:var(--gray);">لا توجد رسائل</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
