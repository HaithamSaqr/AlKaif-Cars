<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <%- include('../partials/admin-head') %>
</head>
<body>
  <%- include('../partials/admin-sidebar') %>

  <div class="admin-main">
    <%- include('../partials/flash-messages') %>

    <div class="breadcrumbs">
      <a href="/admin">لوحة التحكم</a> /
      <a href="/admin/brands">العلامات التجارية</a> /
      <span><%= brand ? 'تعديل العلامة' : 'إضافة علامة جديدة' %></span>
    </div>

    <h1><%= brand ? 'تعديل العلامة التجارية' : 'إضافة علامة تجارية جديدة' %></h1>

    <form action="<%= brand ? '/admin/brands/' + brand.id + '/edit' : '/admin/brands/create' %>" method="POST" enctype="multipart/form-data" data-loading>
      <div class="form-card">
        <div class="form-row">
          <div class="form-group">
            <label for="name_ar">الاسم (عربي)</label>
            <input type="text" name="name_ar" id="name_ar" class="form-control" value="<%= brand ? brand.name_ar : '' %>" required>
          </div>
          <div class="form-group">
            <label for="name_en">الاسم (إنجليزي)</label>
            <input type="text" name="name_en" id="name_en" class="form-control" value="<%= brand ? brand.name_en : '' %>" required>
          </div>
        </div>

        <div class="form-group">
          <label for="sort_order">ترتيب العرض</label>
          <input type="number" name="sort_order" id="sort_order" class="form-control" value="<%= brand ? brand.sort_order : 0 %>" min="0">
        </div>

        <div class="form-group">
          <label>الشعار</label>
          <div class="upload-area" data-input="logoFile">
            <i class="fas fa-cloud-upload-alt"></i>
            <p>اضغط لاختيار شعار العلامة</p>
          </div>
          <input type="file" name="logo" id="logoFile" accept="image/*" data-preview="logoPreview" style="display:none;">
          <div id="logoPreview" class="image-preview-grid"></div>
        </div>

        <% if (brand && brand.logo_path) { %>
        <div class="form-group">
          <label style="color:var(--gray);font-weight:600;">الشعار الحالي</label>
          <div class="image-preview-grid">
            <div class="image-preview-item">
              <img src="<%= brand.logo_path %>" alt="<%= brand.name_en %>">
            </div>
          </div>
        </div>
        <% } %>
      </div>

      <div style="display:flex;gap:12px;margin-top:16px;">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= brand ? 'حفظ التعديلات' : 'إضافة العلامة' %></button>
        <a href="/admin/brands" class="btn btn-outline">إلغاء</a>
      </div>
    </form>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
