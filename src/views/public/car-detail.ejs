<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash-messages') %>

<!-- ========== CAR DETAIL HERO / GALLERY ========== -->
<section class="car-detail-hero">
  <div class="container">
    <% if (typeof car !== 'undefined' && car.images && car.images.length > 0) { %>
      <!-- Main Gallery Image -->
      <div class="car-detail-gallery">
        <img src="/uploads/cars/<%= car.images[0].filename %>" alt="<%= car.name_ar || car.name_en %>" id="mainGalleryImg">
      </div>
      <!-- Thumbnails -->
      <div class="car-detail-thumbs">
        <% car.images.forEach(function(img, idx) { %>
          <div class="car-detail-thumb<%= idx === 0 ? ' active' : '' %>" data-img="/uploads/cars/<%= img.filename %>" onclick="document.getElementById('mainGalleryImg').src=this.dataset.img; document.querySelectorAll('.car-detail-thumb').forEach(t=>t.classList.remove('active')); this.classList.add('active');">
            <img src="/uploads/cars/<%= img.filename %>" alt="<%= car.name_ar || car.name_en %> - <%= idx + 1 %>" loading="lazy">
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="car-detail-gallery" style="background: linear-gradient(135deg, var(--bg-tertiary) 0%, var(--bg-secondary) 50%, var(--bg-tertiary) 100%); display:flex; align-items:center; justify-content:center;">
        <i class="fas fa-car" style="font-size:80px;color:var(--gray-mid);"></i>
      </div>
    <% } %>
  </div>
</section>

<!-- ========== CAR DETAIL LAYOUT ========== -->
<section class="car-detail-layout container">
  <!-- Left Column: Car Info -->
  <div class="car-detail-info">
    <h1><%= car.name_en %></h1>

    <div class="car-detail-meta">
      <span><i class="fa-solid fa-calendar"></i> <%= car.year || '' %></span>
      <span class="car-card-badge <%= car.condition === 'new' ? 'new' : 'used' %>"><%= car.condition === 'new' ? 'جديد' : 'مستعمل' %></span>
      <span><i class="fa-solid fa-car"></i> <%= car.body_type || '' %></span>
    </div>

    <% if (car.price_on_request) { %>
      <div class="car-detail-price">متوفر عند الطلب</div>
    <% } else if (car.price) { %>
      <div class="car-detail-price">
        <%= Number(car.price).toLocaleString('ar-EG') %> <span class="sar">ر.س</span>
      </div>
    <% } %>

    <!-- Specs Grid -->
    <div class="specs-grid">
      <div class="spec-item">
        <i class="fa-solid fa-gas-pump"></i>
        <div class="spec-info">
          <span class="spec-label">نوع المحرك</span>
          <span class="spec-value"><%= car.fuel_type === 'petrol' ? 'بنزين' : car.fuel_type === 'diesel' ? 'ديزل' : car.fuel_type === 'electric' ? 'كهربائي' : car.fuel_type === 'hybrid' ? 'هجين' : (car.fuel_type || '---') %></span>
        </div>
      </div>
      <div class="spec-item">
        <i class="fa-solid fa-gears"></i>
        <div class="spec-info">
          <span class="spec-label">ناقل الحركة</span>
          <span class="spec-value"><%= car.transmission === 'automatic' ? 'أوتوماتيك' : car.transmission === 'manual' ? 'يدوي' : (car.transmission || '---') %></span>
        </div>
      </div>
      <div class="spec-item">
        <i class="fa-solid fa-car-side"></i>
        <div class="spec-info">
          <span class="spec-label">نظام الدفع</span>
          <span class="spec-value"><%= car.drive_type || '---' %></span>
        </div>
      </div>
      <div class="spec-item">
        <i class="fa-solid fa-calendar"></i>
        <div class="spec-info">
          <span class="spec-label">سنة الصنع</span>
          <span class="spec-value"><%= car.year || '---' %></span>
        </div>
      </div>
      <div class="spec-item">
        <i class="fa-solid fa-palette"></i>
        <div class="spec-info">
          <span class="spec-label">اللون</span>
          <span class="spec-value"><%= car.color || '---' %></span>
        </div>
      </div>
      <div class="spec-item">
        <i class="fa-solid fa-couch"></i>
        <div class="spec-info">
          <span class="spec-label">المقاعد</span>
          <span class="spec-value"><%= car.interior || '---' %></span>
        </div>
      </div>
      <div class="spec-item">
        <i class="fa-solid fa-gauge-high"></i>
        <div class="spec-info">
          <span class="spec-label">عداد الكيلومترات</span>
          <span class="spec-value"><%= car.mileage != null ? Number(car.mileage).toLocaleString('ar-EG') + ' كم' : '---' %></span>
        </div>
      </div>
      <div class="spec-item">
        <i class="fa-solid fa-bolt"></i>
        <div class="spec-info">
          <span class="spec-label">قوة المحرك</span>
          <span class="spec-value"><%= car.horsepower ? car.horsepower + ' حصان' : '---' %></span>
        </div>
      </div>
    </div>

    <!-- Description -->
    <% if (car.description) { %>
      <div class="car-detail-description">
        <h3>وصف السيارة</h3>
        <p><%= car.description %></p>
      </div>
    <% } %>

    <!-- Features -->
    <% if (typeof car.features !== 'undefined' && car.features && car.features.length > 0) { %>
      <div class="car-detail-features">
        <h3>المميزات</h3>
        <div class="about-features">
          <% car.features.forEach(function(feature) { %>
            <div class="about-feature">
              <i class="fa-solid fa-check"></i>
              <span><%= typeof feature === 'string' ? feature : feature.name %></span>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Right Column: Full Buy Request -->
  <div class="car-detail-sidebar">
    <div class="inquiry-box buy-request-box">
      <div class="buy-request-header">
        <i class="fas fa-shopping-cart"></i>
        <h3>طلب شراء</h3>
      </div>

      <!-- Auto-filled car summary -->
      <div class="buy-request-car-summary">
        <div class="buy-car-name"><%= car.name_en %></div>
        <div class="buy-car-details">
          <span><i class="fas fa-calendar"></i> <%= car.year || '' %></span>
          <span><i class="fas fa-car"></i> <%= car.body_type || '' %></span>
          <span class="buy-car-condition <%= car.condition === 'new' ? 'new' : 'used' %>"><%= car.condition === 'new' ? 'جديد' : 'مستعمل' %></span>
        </div>
        <% if (!car.price_on_request && car.price) { %>
          <div class="buy-car-price"><%= Number(car.price).toLocaleString('ar-EG') %> <small>ر.س</small></div>
        <% } %>
      </div>

      <form id="buyRequestForm" novalidate>
        <input type="hidden" name="car_name" value="<%= car.name_en %> <%= car.year || '' %>">
        <input type="hidden" name="car_id" value="<%= car.id %>">
        <input type="hidden" name="car_price" value="<%= car.price || '' %>">

        <!-- طريقة الدفع -->
        <div class="form-group">
          <label>طريقة الدفع</label>
          <div class="radio-group radio-group-sm">
            <label class="radio-option">
              <input type="radio" name="payment_method" value="تمويل" checked>
              <span class="radio-mark"></span>
              <span class="radio-text">تمويل</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="payment_method" value="كاش">
              <span class="radio-mark"></span>
              <span class="radio-text">كاش</span>
            </label>
          </div>
        </div>

        <!-- الاسم -->
        <div class="form-group">
          <label>الاسم الكامل</label>
          <input type="text" name="full_name" placeholder="أدخل اسمك الكامل" required>
        </div>

        <!-- رقم الجوال -->
        <div class="form-group">
          <label>رقم الجوال</label>
          <input type="text" name="phone" placeholder="05XXXXXXXX" required>
        </div>

        <!-- الراتب -->
        <div class="form-group">
          <label>الراتب على جهاز الصراف</label>
          <input type="text" name="salary" placeholder="أدخل مبلغ الراتب">
        </div>

        <!-- الالتزامات -->
        <div class="form-group">
          <label>إجمالي الالتزامات</label>
          <input type="text" name="obligations" placeholder="أدخل إجمالي الالتزامات الشهرية">
        </div>

        <!-- قرض عقاري -->
        <div class="form-group">
          <label>هل يوجد قرض عقاري؟</label>
          <div class="radio-group radio-group-sm">
            <label class="radio-option">
              <input type="radio" name="mortgage" value="نعم">
              <span class="radio-mark"></span>
              <span class="radio-text">نعم</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="mortgage" value="لا">
              <span class="radio-mark"></span>
              <span class="radio-text">لا</span>
            </label>
          </div>
        </div>

        <!-- الدفعة الأولى -->
        <div class="form-group">
          <label>الدفعة الأولى</label>
          <div class="radio-group radio-group-sm">
            <label class="radio-option">
              <input type="radio" name="first_payment" value="10%">
              <span class="radio-mark"></span>
              <span class="radio-text">10%</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="first_payment" value="15%">
              <span class="radio-mark"></span>
              <span class="radio-text">15%</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="first_payment" value="20%">
              <span class="radio-mark"></span>
              <span class="radio-text">20%</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="first_payment" value="25%">
              <span class="radio-mark"></span>
              <span class="radio-text">25%</span>
            </label>
          </div>
        </div>

        <!-- الدفعة الأخيرة -->
        <div class="form-group">
          <label>الدفعة الأخيرة</label>
          <div class="radio-group radio-group-sm">
            <label class="radio-option">
              <input type="radio" name="last_payment" value="25%">
              <span class="radio-mark"></span>
              <span class="radio-text">25%</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="last_payment" value="30%">
              <span class="radio-mark"></span>
              <span class="radio-text">30%</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="last_payment" value="35%">
              <span class="radio-mark"></span>
              <span class="radio-text">35%</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="last_payment" value="40%">
              <span class="radio-mark"></span>
              <span class="radio-text">40%</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="last_payment" value="45%">
              <span class="radio-mark"></span>
              <span class="radio-text">45%</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="last_payment" value="50%">
              <span class="radio-mark"></span>
              <span class="radio-text">50%</span>
            </label>
          </div>
        </div>

        <!-- المدينة -->
        <div class="form-group">
          <label>المدينة</label>
          <select name="city" required>
            <option value="" disabled selected>اختر المدينة</option>
            <option value="الرياض">الرياض</option>
            <option value="جدة">جدة</option>
            <option value="مكة المكرمة">مكة المكرمة</option>
            <option value="المدينة المنورة">المدينة المنورة</option>
            <option value="الدمام">الدمام</option>
            <option value="الخبر">الخبر</option>
            <option value="الظهران">الظهران</option>
            <option value="أبها">أبها</option>
            <option value="تبوك">تبوك</option>
            <option value="حائل">حائل</option>
            <option value="الطائف">الطائف</option>
            <option value="بريدة">بريدة</option>
            <option value="نجران">نجران</option>
            <option value="جازان">جازان</option>
            <option value="ينبع">ينبع</option>
          </select>
        </div>

        <!-- قطاع التوظيف -->
        <div class="form-group">
          <label>قطاع التوظيف</label>
          <select name="employment_sector" required>
            <option value="" disabled selected>اختر القطاع</option>
            <option value="حكومي">حكومي</option>
            <option value="عسكري">عسكري</option>
            <option value="قطاع خاص">قطاع خاص</option>
            <option value="شبه حكومي">شبه حكومي</option>
            <option value="أعمال حرة">أعمال حرة</option>
          </select>
        </div>

        <!-- بنك الراتب -->
        <div class="form-group">
          <label>بنك الراتب</label>
          <select name="bank" required>
            <option value="" disabled selected>اختر البنك</option>
            <option value="الراجحي">الراجحي</option>
            <option value="الأهلي">الأهلي</option>
            <option value="الإنماء">الإنماء</option>
            <option value="البلاد">البلاد</option>
            <option value="الرياض">الرياض</option>
            <option value="ساب">ساب</option>
            <option value="العربي">العربي</option>
          </select>
        </div>

        <!-- رخصة القيادة -->
        <div class="form-group">
          <label>رخصة القيادة</label>
          <div class="radio-group radio-group-sm">
            <label class="radio-option">
              <input type="radio" name="license" value="سارية">
              <span class="radio-mark"></span>
              <span class="radio-text">سارية</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="license" value="منتهية">
              <span class="radio-mark"></span>
              <span class="radio-text">منتهية</span>
            </label>
            <label class="radio-option">
              <input type="radio" name="license" value="غير متوفرة">
              <span class="radio-mark"></span>
              <span class="radio-text">غير متوفرة</span>
            </label>
          </div>
        </div>

        <button type="submit" class="submit-btn">
          <i class="fas fa-paper-plane"></i>
          إرسال طلب الشراء
        </button>
      </form>
    </div>

    <!-- Contact Box -->
    <div class="contact-box">
      <a href="tel:<%= (typeof settings !== 'undefined' && settings.phone) ? settings.phone : '+966920012345' %>">
        <i class="fa-solid fa-phone"></i>
        <span>اتصل بنا: <%= (typeof settings !== 'undefined' && settings.phone) ? settings.phone : '920012345' %></span>
      </a>
      <a href="https://wa.me/<%= (typeof settings !== 'undefined' && settings.whatsapp) ? settings.whatsapp : '966920012345' %>" target="_blank">
        <i class="fa-brands fa-whatsapp"></i>
        <span>واتساب: <%= (typeof settings !== 'undefined' && settings.whatsapp) ? settings.whatsapp : '920012345' %></span>
      </a>
      <a href="/contact">
        <i class="fa-solid fa-location-dot"></i>
        <span>زيارة المعرض</span>
      </a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
<%- include('../partials/share-modal') %>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
  // Buy request form - submit via fetch
  (function() {
    var form = document.getElementById('buyRequestForm');
    if (!form) return;
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var formData = new FormData(form);
      var data = {};
      formData.forEach(function(value, key) { data[key] = value; });

      fetch('/api/purchase/individual', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
      .then(function(res) { return res.json(); })
      .then(function(result) {
        if (result.success) {
          alert(result.message || 'تم إرسال طلبك بنجاح! سنتواصل معك قريبا.');
          form.reset();
        } else {
          alert(result.message || 'حدث خطأ أثناء إرسال الطلب. حاول مرة أخرى.');
        }
      })
      .catch(function() {
        alert('حدث خطأ في الاتصال. حاول مرة أخرى.');
      });
    });
  })();
</script>
</body>
</html>
