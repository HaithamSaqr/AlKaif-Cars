<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash-messages') %>

<!-- ========== PAGE HEADER ========== -->
<section class="page-header">
  <div class="container">
    <h1>تواصل معنا</h1>
    <div class="breadcrumb">
      <a href="/">الرئيسية</a>
      <span class="sep">/</span>
      <span>تواصل معنا</span>
    </div>
  </div>
</section>

<!-- ========== CONTACT LAYOUT ========== -->
<div class="container">
  <div class="contact-layout">

    <!-- Contact Form -->
    <div class="contact-form-box">
      <h3>أرسل لنا رسالة</h3>
      <form id="contactForm">
        <div class="form-row">
          <div class="form-group">
            <label>الاسم</label>
            <input type="text" name="name" placeholder="أدخل اسمك الكامل" required>
          </div>
          <div class="form-group">
            <label>البريد الإلكتروني</label>
            <input type="email" name="email" placeholder="أدخل بريدك الإلكتروني" required>
          </div>
        </div>
        <div class="form-group">
          <label>رقم الجوال</label>
          <input type="tel" name="phone" placeholder="05XXXXXXXX">
        </div>
        <div class="form-group">
          <label>عنوان الرسالة</label>
          <input type="text" name="subject" placeholder="أدخل عنوان الرسالة">
        </div>
        <div class="form-group">
          <label>الرسالة</label>
          <textarea name="message" placeholder="اكتب رسالتك هنا..." required></textarea>
        </div>
        <button type="submit" class="form-submit-btn">
          <i class="fas fa-paper-plane"></i>
          إرسال الرسالة
        </button>
      </form>
    </div>

    <!-- Branches -->
    <div class="branches-container">
      <% if (typeof branches !== 'undefined' && branches.length > 0) { %>
        <% branches.forEach(function(branch) { %>
          <div class="branch-card">
            <h3><i class="fas fa-building"></i> <%= branch.name %></h3>
            <% if (branch.address) { %>
              <div class="branch-info-row">
                <i class="fas fa-location-dot"></i>
                <span><%= branch.address %></span>
              </div>
            <% } %>
            <% if (branch.phone) { %>
              <div class="branch-info-row">
                <i class="fas fa-phone"></i>
                <a href="tel:<%= branch.phone %>"><%= branch.phone %></a>
              </div>
            <% } %>
            <% if (branch.hours) { %>
              <div class="branch-info-row">
                <i class="fas fa-clock"></i>
                <span><%= branch.hours %></span>
              </div>
            <% } %>
            <% if (branch.whatsapp || branch.phone) { %>
              <a href="https://wa.me/<%= branch.whatsapp || branch.phone %>" target="_blank" class="branch-whatsapp">
                <i class="fab fa-whatsapp"></i>
                تواصل عبر الواتساب
              </a>
            <% } %>
          </div>
        <% }); %>
      <% } else { %>
        <!-- Fallback static branches -->
        <div class="branch-card">
          <h3><i class="fas fa-building"></i> الفرع الرئيسي</h3>
          <div class="branch-info-row">
            <i class="fas fa-location-dot"></i>
            <span><%= (typeof settings !== 'undefined' && settings.address) ? settings.address : 'الرياض، المملكة العربية السعودية' %></span>
          </div>
          <div class="branch-info-row">
            <i class="fas fa-phone"></i>
            <a href="tel:<%= (typeof settings !== 'undefined' && settings.phone) ? settings.phone : '920012345' %>"><%= (typeof settings !== 'undefined' && settings.phone) ? settings.phone : '920012345' %></a>
          </div>
          <div class="branch-info-row">
            <i class="fas fa-clock"></i>
            <span>الأحد - الخميس: 9 ص - 12 م، 4 م - 9 م</span>
          </div>
          <a href="https://wa.me/<%= (typeof settings !== 'undefined' && settings.whatsapp) ? settings.whatsapp : '966920012345' %>" target="_blank" class="branch-whatsapp">
            <i class="fab fa-whatsapp"></i>
            تواصل عبر الواتساب
          </a>
        </div>
      <% } %>
    </div>

  </div>
</div>

<!-- ========== MAP SECTION ========== -->
<section class="map-section">
  <div class="map-placeholder">
    <i class="fas fa-map-marked-alt"></i>
    <span>خريطة الموقع</span>
  </div>
</section>

<%- include('../partials/footer') %>
<%- include('../partials/share-modal') %>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
  // Contact form - submit via fetch
  (function() {
    var form = document.getElementById('contactForm');
    if (!form) return;
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var formData = new FormData(form);
      var data = {};
      formData.forEach(function(value, key) { data[key] = value; });

      fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
      .then(function(res) { return res.json(); })
      .then(function(result) {
        if (result.success) {
          alert(result.message || 'تم إرسال رسالتك بنجاح! سنتواصل معك قريبا.');
          form.reset();
        } else {
          alert(result.message || 'حدث خطأ أثناء إرسال الرسالة. حاول مرة أخرى.');
        }
      })
      .catch(function() {
        alert('حدث خطأ في الاتصال. حاول مرة أخرى.');
      });
    });
  })();
</script>
</body>
</html>
